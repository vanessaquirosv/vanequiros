rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /comprobantes_sinpe/{allPaths=**} {
      // Subida SOLO con usuario autenticado (Auth anónimo) + restricciones.
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // No exponer públicamente por listing; el acceso será por downloadURL si se requiere.
      allow read: if false;
    }
  }
}

