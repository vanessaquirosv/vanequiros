rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Boletos de rifa (000-999) ---
    match /tickets/{ticketId} {
      allow read: if true;

      // Solo reserva: disponible → reservado con orderId (transacción de compra)
      allow update: if resource.data.status == 'disponible'
                    && request.resource.data.status == 'reservado'
                    && request.resource.data.orderId is string
                    && request.resource.data.orderId.size() > 0;

      // Crear boletos solo durante seed inicial (meta/config aún no existe)
      allow create: if ticketId.matches('^[0-9]{1,3}$')
                    && !exists(/databases/$(database)/documents/meta/config);

      allow delete: if false;
    }

    // --- Pedidos de compradores ---
    match /orders/{orderId} {
      allow read: if false;
      allow create: if request.resource.data.status == 'pendiente_pago'
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.telefono is string
                    && request.resource.data.telefono.size() > 0
                    && request.resource.data.boletos is list
                    && request.resource.data.boletos.size() > 0
                    && request.resource.data.boletos.size() <= 30
                    && request.resource.data.total is number
                    && request.resource.data.precioUnitario == 2000;
      allow update, delete: if false;
    }

    // --- Meta (marca seed completado) ---
    match /meta/{docId} {
      allow read: if true;
      allow create: if docId == 'config'
                    && request.resource.data.seeded == true
                    && !exists(/databases/$(database)/documents/meta/config);
      allow update, delete: if false;
    }
  }
}
